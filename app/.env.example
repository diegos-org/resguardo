# Copie para .env.local (nunca commitar valores reais).
# Banco (criado pela integração Neon na Vercel)
DATABASE_URL=
# Login (Auth.js) — gere AUTH_SECRET com: npx auth secret
AUTH_SECRET=
# Credenciais OAuth do Google (Google Cloud Console → APIs e serviços → Credenciais)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails que viram administradores no primeiro login (separados por vírgula)
ADMIN_EMAILS=
