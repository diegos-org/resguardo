# Copie para .env.local (nunca commitar valores reais).
# Banco (criado pela integração Neon na Vercel)
DATABASE_URL=
# Login (Auth.js) — gere AUTH_SECRET com: npx auth secret
AUTH_SECRET=
# Credenciais OAuth do Google (Google Cloud Console → APIs e serviços → Credenciais)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails que viram administradores no primeiro login (separados por vírgula)
ADMIN_EMAILS=
# Login por código enviado por e-mail (M1.3). Sem isto, só o Google funciona
# (em `next dev` o código aparece no terminal). Provedor: Resend (resend.com).
RESEND_API_KEY=
# Remetente verificado no provedor, ex.: Sua Casa Leblon <acesso@seudominio.com.br>
EMAIL_REMETENTE=
# Beds24: refresh token obtido ao trocar o invite code na API v2.
# O servidor gera/renova o access token. Não colocar o invite code aqui.
# Tem prioridade sobre BEDS24_API_KEY. Cliente atual: SOMENTE LEITURA.
BEDS24_REFRESH_TOKEN=
# Alternativa legada: token de acesso direto (long life = somente leitura).
# Nunca colocar refresh token ou invite code em BEDS24_API_KEY.
BEDS24_API_KEY=
# Site público (M7.1): de qual organização é o site. Opcional com uma organização só no banco;
# com mais de uma, sem esta variável o site mostra "Site em configuração".
SITE_ORGANIZACAO_ID=
